---
// Import Komponen Universal
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import QuoteModal from '../components/QuoteModal.astro';
import FloatingWA from '../components/FloatingWA.astro';
import { ClientRouter } from 'astro:transitions';
import { SITE_CONFIG } from '../config';
import { getCollection } from 'astro:content';

// Ambil Scripts dari Koleksi (CMS)
const scripts = await getCollection('scripts', ({ data }) => data.status === 'active');
const headScripts = scripts.filter(s => s.data.location === 'head');
const bodyStartScripts = scripts.filter(s => s.data.location === 'body-start');
const bodyEndScripts = scripts.filter(s => s.data.location === 'body-end');

// Definisi Props Master
interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article' | 'product';
	showBreadcrumbs?: boolean;
	noIndex?: boolean; 
	isFullWidth?: boolean;
	canonical?: string; // Tambahan untuk Custom Canonical
	prevUrl?: string; // SEO: Rel Prev
	nextUrl?: string; // SEO: Rel Next
}

const { 
	title, 
	description = "Distributor Alat Laboratorium Teknik Sipil Terlengkap (Beton, Aspal, Tanah, Batuan). Berstandar SNI & ASTM.", 
	image = "/images/default-og.jpg",
	type = "website",
	showBreadcrumbs = true,
	noIndex = false,
	isFullWidth = false,
	canonical, // Ambil prop canonical
	prevUrl,
	nextUrl
} = Astro.props;

// Logic Canonical: Jika ada prop canonical pakai itu, jika tidak pakai URL sekarang
const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).toString();

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';

// URL pagination dari Astro tidak memakai trailing slash; samakan dengan
// bentuk canonical situs agar rel=prev/next tidak menunjuk URL yang dialihkan.
function normalizePaginationUrl(value?: string) {
  if (!value) return undefined;
  return value.endsWith('/') ? value : `${value}/`;
}

const prevHref = normalizePaginationUrl(prevUrl);
const nextHref = normalizePaginationUrl(nextUrl);

// --- Structured Data ---
// Semua node dikirim dalam satu @graph dengan @id tetap, supaya Google
// membaca Organization, LocalBusiness, WebSite, dan WebPage sebagai satu
// entitas yang saling terhubung (bukan beberapa entitas terpisah).
const siteUrl = new URL('/', Astro.site).toString();
const orgId = new URL('/#organization', Astro.site).toString();
const websiteId = new URL('/#website', Astro.site).toString();
const logoId = new URL('/#logo', Astro.site).toString();
const logoUrl = new URL('/logo.png', Astro.site).toString();
const orgImageUrl = new URL('/images/alat-laboratorium-teknik-sipil.webp', Astro.site).toString();
const pageImageUrl = new URL(image, Astro.site).toString();
const webpageId = `${canonicalURL}#webpage`;
const breadcrumbId = `${canonicalURL}#breadcrumb`;

const organizationNode = {
  "@type": ["Organization", "LocalBusiness"],
  "@id": orgId,
  "name": SITE_CONFIG.brandName,
  "alternateName": "Pusat Alat Lab Sipil",
  "url": siteUrl,
  "description": "Distributor alat laboratorium teknik sipil untuk pengujian beton, aspal, tanah, dan batuan dengan standar SNI dan ASTM.",
  "email": SITE_CONFIG.email,
  "telephone": `+${SITE_CONFIG.whatsapp}`,
  "logo": {
    "@type": "ImageObject",
    "@id": logoId,
    "url": logoUrl,
    "contentUrl": logoUrl,
    "caption": SITE_CONFIG.brandName
  },
  "image": orgImageUrl,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": SITE_CONFIG.address,
    "addressLocality": "Cimahi",
    "addressRegion": "Jawa Barat",
    "postalCode": "40535",
    "addressCountry": "ID"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -6.9000888,
    "longitude": 107.5625715
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday"
    ],
    "opens": "08:00",
    "closes": "17:00"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": `+${SITE_CONFIG.whatsapp}`,
    "email": SITE_CONFIG.email,
    "contactType": "sales",
    "areaServed": "ID",
    "availableLanguage": "Indonesian"
  },
  "areaServed": {
    "@type": "Country",
    "name": "Indonesia"
  },
  "knowsAbout": [
    "Alat laboratorium teknik sipil",
    "Pengujian beton",
    "Pengujian aspal",
    "Pengujian tanah",
    "Pengujian batuan"
  ]
};

const websiteNode = {
  "@type": "WebSite",
  "@id": websiteId,
  "url": siteUrl,
  "name": SITE_CONFIG.brandName,
  "alternateName": "Pusat Alat Lab Sipil",
  "publisher": { "@id": orgId },
  "inLanguage": "id-ID"
};

// Breadcrumbs Generator Logic
// Label khusus untuk segmen URL yang bukan nama halaman.
const SEGMENT_LABELS = {
  products: 'Katalog',
  blog: 'Blog',
};

// Segmen yang hanya bagian dari struktur URL dan tidak punya halaman sendiri.
// Contoh: /blog/tag/insight/ -> "tag" tidak boleh jadi item breadcrumb.
const ROUTING_ONLY_SEGMENTS = new Set(['tag']);

function humanizeSegment(segment) {
  let decoded = segment;
  try {
    decoded = decodeURIComponent(segment);
  } catch {
    // biarkan segment apa adanya kalau bukan URI valid
  }

  const cleaned = decoded
    .replace(/[-_]+/g, ' ')
    .replace(/[^\p{L}\p{N} ]+/gu, ' ')
    .replace(/\s+/g, ' ')
    .trim();

  if (!cleaned) return '';
  return cleaned.replace(/\b\w/g, (char) => char.toUpperCase());
}

const rawSegments = currentPath.split('/').filter(Boolean);
const pageNumber = /^\d+$/.test(rawSegments[rawSegments.length - 1] ?? '')
  ? rawSegments[rawSegments.length - 1]
  : null;

const breadcrumbs = rawSegments
  .map((segment, index) => {
    const href = '/' + rawSegments.slice(0, index + 1).join('/') + '/';
    const isNumeric = /^\d+$/.test(segment);
    const isRoutingOnly = ROUTING_ONLY_SEGMENTS.has(segment.toLowerCase());
    const name = SEGMENT_LABELS[segment.toLowerCase()] ?? humanizeSegment(segment);
    return { name, href, isNumeric, isRoutingOnly };
  })
  // Segmen angka adalah nomor halaman pagination, bukan halaman tersendiri.
  .filter((crumb) => !crumb.isNumeric && !crumb.isRoutingOnly && crumb.name);

if (pageNumber) {
  breadcrumbs.push({
    name: `Halaman ${pageNumber}`,
    href: currentPath,
    isNumeric: false,
    isRoutingOnly: false,
  });
}

// Breadcrumb hanya dirender (visual & schema) bila memang tampil di halaman.
const showBreadcrumbBlock = !isHome && showBreadcrumbs && !isFullWidth;

// BreadcrumbList — butuh minimal 2 item (Home + 1) agar valid.
const breadcrumbNode =
  showBreadcrumbBlock && breadcrumbs.length > 0
    ? {
        "@type": "BreadcrumbList",
        "@id": breadcrumbId,
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": siteUrl
          },
          ...breadcrumbs.map((crumb, index) => ({
            "@type": "ListItem",
            "position": index + 2,
            "name": crumb.name,
            "item": new URL(crumb.href, Astro.site).toString()
          }))
        ]
      }
    : null;

// WebPage menghubungkan halaman ke WebSite dan Organization lewat @id,
// jadi setiap halaman ikut memperkuat entitas yang sama.
const webpageNode = {
  "@type": "WebPage",
  "@id": webpageId,
  "url": canonicalURL,
  "name": title,
  "description": description,
  "isPartOf": { "@id": websiteId },
  "about": { "@id": orgId },
  "inLanguage": "id-ID",
  "primaryImageOfPage": {
    "@type": "ImageObject",
    "url": pageImageUrl
  },
  ...(breadcrumbNode ? { "breadcrumb": { "@id": breadcrumbId } } : {})
};

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    organizationNode,
    websiteNode,
    webpageNode,
    ...(breadcrumbNode ? [breadcrumbNode] : [])
  ]
};
---

<!doctype html>
<html lang="id" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Render Head Scripts dari CMS -->
		{headScripts.map(s => <Fragment set:html={s.data.code} />)}

{noIndex ? (
  <meta name="robots" content="noindex, follow, max-image-preview:large" />
) : (
  <meta name="robots" content="index, follow, max-image-preview:large" />
)}

		<title>{title} | {SITE_CONFIG.brandName}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.site)} />

		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(image, Astro.site)} />

		{prevHref && <link rel="prev" href={new URL(prevHref, Astro.site).toString()} />}
		{nextHref && <link rel="next" href={new URL(nextHref, Astro.site).toString()} />}

		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800;900&display=swap" rel="stylesheet">

		<ClientRouter />
		<slot name="head" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <meta name="theme-color" content="#e6c55c">
	</head>
	
	<body class="bg-gray-50 text-civil-dark font-sans flex flex-col min-h-screen">
		
		<!-- Render Body Start Scripts dari CMS -->
		{bodyStartScripts.map(s => <Fragment set:html={s.data.code} />)}
		
		<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-civil-secondary focus:text-civil-primary focus:font-bold focus:shadow-hard">
			Skip to Main Content
		</a>

		<div class="bg-civil-dark text-white text-[10px] md:text-xs font-bold text-center py-2 px-4 tracking-wide relative z-50">
			PROMO OKTOBER: Diskon hingga 20% dan garansi 1 tahun untuk semua produk! <a href="/products/" class="underline hover:text-civil-secondary transition-colors">Belanja Sekarang</a>
		</div>

		<Header />

		{showBreadcrumbBlock && (
			<div class="border-b border-gray-200 bg-white py-3 w-full">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-xs font-mono text-gray-500 uppercase tracking-tight">
					<a href="/" class="hover:text-civil-primary transition-colors">Home</a>
					
					{breadcrumbs.map((crumb, index) => (
						<>
							<span class="mx-2 text-gray-300">/</span>
							{index === breadcrumbs.length - 1 ? (
								<span class="font-bold text-civil-dark">{crumb.name}</span>
							) : (
								<a href={crumb.href} class="hover:text-civil-primary transition-colors">{crumb.name}</a>
							)}
						</>
					))}
				</div>
			</div>
		)}

		<div id="main-content" class:list={[
			"flex-grow focus:outline-none", 
			isFullWidth ? "w-full" : "max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full"
		]} tabindex="-1">
			
			<main>
				<slot />
			</main>
		</div>

		<Footer />

		<FloatingWA />
		<SearchModal />
		<QuoteModal />

		<!-- Render Body End Scripts dari CMS -->
		{bodyEndScripts.map(s => <Fragment set:html={s.data.code} />)}

		<script>
			import { trackWAClick } from '../lib/tracking';

			// Ekspos helper untuk komponen lain (mis. QuoteModal).
			(window as any).__waTrack = trackWAClick;

			/**
			 * Tebak sumber klik untuk tombol WA yang tidak diberi data-wa-source
			 * (mis. link di konten Markdown/CMS).
			 */
			function guessWASource(el: HTMLElement): { source: string; product: string } {
				const href = el.getAttribute('href') || '';

				// Share blog: wa.me tanpa nomor tujuan.
				if (/^https:\/\/wa\.me\/\?/.test(href) || href.includes('api.whatsapp.com/send?text')) {
					return { source: 'blog_share', product: document.title };
				}

				if (document.querySelector('article.prose, .prose') && location.pathname.startsWith('/blog/')) {
					return { source: 'blog_inline', product: document.title };
				}

				const h1 = document.querySelector('h1')?.textContent?.trim() || '';
				return { source: 'inline_link', product: h1 };
			}

			// Delegasi klik: tangkap semua tombol WA yang punya data-wa-source,
			// termasuk elemen yang dirender dinamis.
			document.addEventListener(
				'click',
				(event) => {
					const target = event.target as Element | null;

					// 1) Tombol ber-atribusi eksplisit.
					const tagged = target?.closest?.('[data-wa-source]') as HTMLElement | null;
					if (tagged) {
						trackWAClick({
							source: tagged.dataset.waSource || 'unknown',
							clickType: (tagged.dataset.waType as 'direct' | 'modal') || 'direct',
							product: tagged.dataset.waProduct || '',
						});
						return;
					}

					// 2) Fallback: link/konten WA tanpa atribusi.
					const link = target?.closest?.('a[href*="wa.me"], a[href*="api.whatsapp.com"]') as HTMLElement | null;
					if (!link) return;

					const guess = guessWASource(link);
					trackWAClick({
						source: guess.source,
						clickType: 'direct',
						product: guess.product,
					});
				},
				{ capture: true }
			);
		</script>

	</body>
</html>

<style is:global>
    /* 1. Base Font Settings */
    h1, h2, h3, h4, h5, h6 { 
        font-weight: 800; 
        letter-spacing: -0.025em; 
        color: #0F253E; 
    }
    
    ::-webkit-scrollbar { width: 10px; }
    ::-webkit-scrollbar-track { background: #f1f1f1; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; }
    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

    /* 3. TYPOGRAPHY STYLING */
    .prose { max-width: none; }
    
    .prose h2 { 
        @apply text-2xl md:text-3xl font-black mt-10 mb-6 border-b-4 border-civil-secondary inline-block pb-1 pr-10 text-civil-primary uppercase; 
    }
    
    .prose h3 { 
        @apply text-xl font-bold mt-8 mb-4 text-civil-dark flex items-center gap-2;
    }
    .prose h3::before {
        content: '';
        @apply block w-2 h-6 bg-civil-secondary;
    }

    .prose p { @apply mb-6 leading-relaxed text-gray-700; }
    
    /* --- LIST STYLE (REVISI FINAL) --- */
    
    /* 1. Unordered List (UL) - Centang Kuning */
    .prose ul { 
        @apply list-none ml-2 mb-6 space-y-2; 
    }
    .prose ul > li { 
        @apply relative pl-6 text-gray-700; 
    }
    .prose ul > li::before {
        content: '✓';
        @apply absolute left-0 text-civil-secondary font-black;
    }

    /* 2. Ordered List (OL) - Angka Saja (TANPA CENTANG) */
    .prose ol { 
        @apply list-decimal ml-5 mb-6 text-gray-700; 
    }
    
    /* Kita tembak semua LI di dalam OL, dimanapun dia berada */
    .prose ol li { 
        padding-left: 0 !important;
        list-style-type: decimal !important; /* Paksa muncul angka */
        display: list-item !important; 
    }
    
    /* HAPUS paksa elemen 'before' (si centang) di dalam OL */
    .prose ol li::before {
        content: none !important; 
        display: none !important;
    }
    
    /* Reset font weight isi list */
    .prose ol li span { @apply font-normal; } 

    .prose blockquote {
        @apply border-l-4 border-civil-primary bg-gray-50 p-6 italic text-gray-600 my-8 rounded-r-sm;
    }

    .prose img { @apply rounded-sm border-2 border-gray-200 shadow-md my-8 w-full h-auto; }

    /* TABLE STYLING */
    .prose table { @apply w-full text-sm text-left border-collapse border-2 border-civil-dark my-8 shadow-sm; display: block; overflow-x: auto; white-space: nowrap; -webkit-overflow-scrolling: touch;}
    .prose thead { @apply bg-civil-primary text-white; }
    .prose th { @apply px-4 py-3 text-white uppercase tracking-wider border-r border-civil-dark/20 text-xs md:text-sm; }
    .prose tbody tr { @apply border-b border-gray-200 transition-colors; }
    .prose tbody tr:nth-child(even) { @apply bg-gray-50; }
    .prose tbody tr:hover { @apply bg-blue-50; }
    .prose td { @apply px-4 py-3 border-r border-gray-200 text-gray-700; }
    .table-wrapper { @apply overflow-x-auto my-6 border border-gray-200 rounded-sm; }

	  .content-body {
    overflow-wrap: anywhere;
  }

  .content-body :where(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    white-space: nowrap;
    border-collapse: collapse;
    border: 2px solid rgb(229 231 235);
  }

  .content-body :where(thead th) {
    background: #0F253E;
    color: white;
  }

  .content-body :where(th),
  .content-body :where(td) {
    min-width: 140px;
    vertical-align: top;
  }

  .content-body :where(ul),
  .content-body :where(ol) {
    padding-left: 1.25rem;
  }
  
</style>