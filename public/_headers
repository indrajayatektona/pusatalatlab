# Aturan cache untuk Cloudflare Pages.
#
# Catatan: file ini hanya berlaku untuk aset statis. HTML dirender oleh worker
# dan sudah mengirim "Cache-Control: public, max-age=0, must-revalidate".

# Aset Astro memakai hash pada nama file, jadi isinya tidak akan berubah
# untuk URL yang sama. Aman di-cache selamanya.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Font lokal bersifat statis.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Gambar konten memakai nama file tetap walau isinya diganti, jadi jangan
# di-cache terlalu lama. stale-while-revalidate menjaga gambar tetap tampil
# saat browser memperbarui cache di latar belakang.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# llms.txt disajikan sebagai aset statis (masuk exclude _routes.json).
/llms.txt
  Cache-Control: public, max-age=3600

# Catatan: robots.txt, sitemap-*.xml, dan rss.xml saat ini dirender oleh worker
# (tidak masuk daftar exclude di _routes.json), sehingga aturan _headers tidak
# berlaku untuk berkas tersebut. Cache-nya diatur oleh worker (max-age=14400).
